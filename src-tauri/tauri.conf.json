{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wireframe",
  "version": "2026.11.17",
  "identifier": "com.pake.afe0707",
  "build": {
    "beforeBuildCommand": "npm run prepare-desktop",
    "beforeDevCommand": "npm run prepare-desktop",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wireframe",
        "width": 1200,
        "height": 780,
        "create": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
